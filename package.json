{
  "name": "gcsc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "GCSC three-repository migration candidate; not a production release",
  "scripts": {
    "test": "node --test tests/migration.test.mjs",
    "test:api-config": "node --test tests/api-config.test.mjs",
    "check:api-syntax": "node --check services/api/v3/pure-server.js",
    "check:web": "node scripts/check-web.mjs",
    "check:integration-contracts": "node scripts/check-api-contracts.mjs",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:contracts": "npm --prefix contracts/gcsc-core test",
    "check": "npm test && npm run check:api-syntax && npm run check:web"
  },
  "engines": { "node": ">=20" }
}
