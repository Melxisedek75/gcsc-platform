{
  "status": "SPEC_ONLY",
  "version": "priority-access-v1-draft",
  "liveSettlementEnabled": false,
  "records": [
    "project_opportunity",
    "access_round",
    "access_offer",
    "access_grant",
    "access_settlement",
    "work_proposal",
    "marketplace_audit_event"
  ],
  "projectStates": [
    "draft",
    "open_preview",
    "access_round",
    "exclusive_access",
    "proposal_review",
    "awarded",
    "reopened",
    "cancelled",
    "moderation_hold"
  ],
  "roundStates": [
    "scheduled",
    "bidding",
    "finalized",
    "active",
    "proposal_submitted",
    "expired",
    "rejected",
    "refunded",
    "closed"
  ],
  "offerStates": ["quoted", "payment_verified", "won", "lost", "cancelled"],
  "grantStates": ["active", "proposal_submitted", "expired", "closed"],
  "settlementStates": ["verified", "allocated", "refunded", "failed"],
  "durationHours": [1, 4, 12],
  "bindingFields": {
    "accessOffer": ["offerId", "roundId", "contractorUserId", "challengeId", "quoteHash", "policyVersion"],
    "paymentChallenge": ["challengeId", "offerId", "quoteHash", "amountMinor", "asset", "network", "recipient", "memo", "policyVersion", "expiresAt"],
    "verifiedReceipt": ["receiptId", "challengeId", "offerId", "networkTransactionId", "payerAccount", "amountMinor", "asset", "network", "recipient", "memo"],
    "accessSettlement": ["settlementId", "offerId", "challengeId", "receiptId", "verifiedAmountMinor", "outcomeVersion"]
  },
  "paymentChallengeFields": [
    "amountMinor",
    "asset",
    "network",
    "recipient",
    "memo",
    "policyVersion",
    "expiresAt",
    "idempotencyKey"
  ],
  "endpoints": [
    { "method": "GET", "path": "/api/priority-access/opportunities", "result": "privacy_safe_preview" },
    { "method": "POST", "path": "/api/priority-access/rounds/:roundId/offers", "result": "versioned_payment_challenge" },
    { "method": "POST", "path": "/api/priority-access/settlements/verify", "result": "idempotent_receipt" },
    { "method": "POST", "path": "/api/priority-access/rounds/:roundId/finalize", "result": "single_access_grant" },
    { "method": "GET", "path": "/api/priority-access/grants/:grantId/opportunity", "result": "grant_holder_full_record" },
    { "method": "POST", "path": "/api/priority-access/grants/:grantId/proposals", "result": "versioned_work_proposal" },
    { "method": "POST", "path": "/api/priority-access/proposals/:proposalId/decision", "result": "homeowner_decision" },
    { "method": "POST", "path": "/api/priority-access/grants/:grantId/expire", "result": "audited_grant_expiry" },
    { "method": "POST", "path": "/api/priority-access/settlements/:settlementId/outcome", "result": "idempotent_accounting_outcome" },
    { "method": "POST", "path": "/api/priority-access/rounds/:roundId/reopen", "result": "audited_new_round" }
  ],
  "transitions": [
    { "operation": "create_offer", "projectFrom": ["access_round"], "roundFrom": ["bidding"], "offerTo": "quoted", "actor": "eligible_contractor", "idempotencyScope": "round_contractor_key", "reject": "state_or_eligibility_conflict" },
    { "operation": "verify_receipt", "projectFrom": ["access_round"], "roundFrom": ["bidding"], "offerFrom": ["quoted"], "offerTo": "payment_verified", "settlementTo": "verified", "actor": "receipt_verifier", "idempotencyScope": "offer_challenge_network_transaction", "reject": "expired_or_quote_binding_mismatch" },
    { "operation": "finalize_round", "projectFrom": ["access_round"], "projectTo": "exclusive_access", "roundFrom": ["bidding"], "roundTo": "active", "offerFrom": ["payment_verified"], "offerTo": "won", "grantTo": "active", "actor": "authorized_finalizer", "idempotencyScope": "round_finalization", "reject": "not_bidding_or_no_verified_winner" },
    { "operation": "submit_proposal", "projectFrom": ["exclusive_access"], "projectTo": "proposal_review", "roundFrom": ["active"], "roundTo": "proposal_submitted", "grantFrom": ["active"], "grantTo": "proposal_submitted", "actor": "active_grant_holder", "idempotencyScope": "grant_proposal_revision", "reject": "expired_closed_or_wrong_holder" },
    { "operation": "accept_proposal", "projectFrom": ["proposal_review"], "projectTo": "awarded", "roundFrom": ["proposal_submitted"], "roundTo": "closed", "grantFrom": ["proposal_submitted"], "grantTo": "closed", "actor": "owning_homeowner", "idempotencyScope": "proposal_decision", "reject": "already_decided_or_wrong_owner" },
    { "operation": "reject_proposal", "projectFrom": ["proposal_review"], "projectTo": "reopened", "roundFrom": ["proposal_submitted"], "roundTo": "rejected", "grantFrom": ["proposal_submitted"], "grantTo": "closed", "actor": "owning_homeowner", "idempotencyScope": "proposal_decision", "reject": "already_decided_or_wrong_owner" },
    { "operation": "request_revision", "projectFrom": ["proposal_review"], "projectTo": "proposal_review", "roundFrom": ["proposal_submitted"], "roundTo": "proposal_submitted", "grantFrom": ["proposal_submitted"], "grantTo": "proposal_submitted", "actor": "owning_homeowner", "idempotencyScope": "proposal_revision_request", "reject": "already_decided_or_wrong_owner" },
    { "operation": "expire_grant", "projectFrom": ["exclusive_access"], "projectTo": "reopened", "roundFrom": ["active"], "roundTo": "expired", "grantFrom": ["active"], "grantTo": "expired", "actor": "server_clock_worker", "idempotencyScope": "grant_expiry", "reject": "not_active_or_before_expiry" },
    { "operation": "record_outcome", "settlementFrom": ["verified"], "settlementTo": "allocated", "actor": "settlement_policy_worker", "idempotencyScope": "settlement_outcome_version", "reject": "outcome_not_eligible_or_already_recorded" },
    { "operation": "reopen_round", "projectFrom": ["reopened"], "projectTo": "access_round", "roundFrom": ["expired", "rejected", "refunded"], "roundTo": "scheduled", "actor": "authorized_reopener", "idempotencyScope": "closed_round_reopen", "reject": "source_round_not_closed_or_already_reopened" }
  ],
  "uniqueness": [
    "one_active_grant_per_project",
    "one_active_grant_per_contractor",
    "one_receipt_per_network_transaction",
    "one_challenge_per_access_offer",
    "one_verified_receipt_per_access_offer",
    "one_access_settlement_per_access_offer",
    "one_outcome_per_access_settlement",
    "one_ledger_entry_per_settlement_outcome_and_entry_type",
    "one_reopen_transition_per_closed_round"
  ],
  "settlementOutcomes": {
    "awarded_to_grant_holder": { "refundBps": 0, "platformBps": 10000 },
    "compliant_proposal_not_awarded": { "refundBps": 5000, "platformBps": 5000 },
    "access_not_delivered": { "refundBps": 10000, "platformBps": 0 }
  },
  "accounting": {
    "allocationBase": "accessSettlement.verifiedAmountMinor",
    "integerType": "non_negative_bigint_minor_units",
    "refundFormula": "floor(verifiedAmountMinor * refundBps / 10000)",
    "platformFormula": "verifiedAmountMinor - refundMinor",
    "residualRecipient": "platform",
    "conservationRule": "refundMinor + platformMinor = verifiedAmountMinor",
    "ledgerEntryKey": "settlementId:outcomeVersion:entryType",
    "ledgerEntriesImmutable": true,
    "liveTransferAuthorized": false
  },
  "requiredPersistenceCases": [
    "duplicate_callback_returns_same_receipt_and_ledger_entries",
    "failed_audit_insert_rolls_back_state_and_ledger",
    "restart_recovers_offer_challenge_receipt_settlement_and_ledger_bindings"
  ],
  "prohibited": [
    "label_access_offer_as_work_bid",
    "expose_contact_before_active_grant",
    "finalize_without_verified_receipt",
    "extend_active_grant_after_award",
    "enable_live_asset_without_legal_security_founder_gates"
  ]
}
